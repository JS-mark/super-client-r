# Electron binary + electron-builder binaries mirror (npmmirror.com).
# Historically we kept mirror unset because npmmirror was missing
# electron-builder-binaries (dmg-builder), which broke `pnpm build`. That
# mirror is now populated at
# https://registry.npmmirror.com/-/binary/electron-builder-binaries/, so we
# pin both here to unblock users on networks that can't reach github.com's
# release CDN. If you hit an odd binary version gap or want to force the
# upstream, override these in your ~/.npmrc.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://registry.npmmirror.com/-/binary/electron-builder-binaries/

engine-strict=true

# Allow required postinstall scripts to run.
only-built-dependencies[]=bun
only-built-dependencies[]=better-sqlite3
only-built-dependencies[]=electron
only-built-dependencies[]=node-pty
only-built-dependencies[]=protobufjs
only-built-dependencies[]=msw
only-built-dependencies[]=@scarf/scarf
